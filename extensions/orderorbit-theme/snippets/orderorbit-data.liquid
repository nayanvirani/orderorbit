{%- comment -%}
  Published experiences (app-owned metafield written by Growvia) and the minimal
  page context the runtime needs for targeting. No names, emails or addresses are
  output. For a signed-in customer, segments (Audiences) also use their order count,
  total spent, tags, last order date and recently purchased products; this only
  appears on that customer's own pages. Cart lines carry only product, variant,
  quantity, price and the Growvia offer that added them.
  Duplicates across several blocks are harmless; the runtime reads the first.
{%- endcomment -%}
<script type="application/json" data-oo-data>{{ app.metafields.orderorbit.experiences.value | json }}</script>
{%- if customer -%}{%- capture oo_products -%}{%- for order in customer.orders limit: 10 -%}{%- for item in order.line_items -%}{{ item.product_id }},{%- endfor -%}{%- endfor -%}{%- endcapture -%}{%- endif -%}
<script type="application/json" data-oo-context>
  {
    "page": {{ request.page_type | json }},
    "product": {{ product.id | json }},
    "productTitle": {{ product.title | json }},
    "productHandle": {{ product.handle | json }},
    "productPrice": {{ product.selected_or_first_available_variant.price | json }},
    "productCompareAt": {{ product.selected_or_first_available_variant.compare_at_price | json }},
    "productImage": {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | json }}{% else %}null{% endif %},
    "variant": {{ product.selected_or_first_available_variant.id | json }},
    "soldOut": {% if product %}{ {%- for v in product.variants -%}"{{ v.id }}": {% if v.inventory_management and v.inventory_quantity <= 0 %}true{% else %}false{% endif %}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }{% else %}null{% endif %},
    "collections": {{ product.collections | map: 'id' | json }},
    "loggedIn": {% if customer %}true{% else %}false{% endif %},
    "ordersCount": {{ customer.orders_count | default: 0 | json }},
    "customer": {% if customer %}{"spent": {{ customer.total_spent | default: 0 | json }}, "tags": {{ customer.tags | json }}, "lastOrderAt": {% if customer.last_order %}{{ customer.last_order.created_at | date: '%s' | json }}{% else %}null{% endif %}, "products": {{ oo_products | split: ',' | uniq | json }}}{% else %}null{% endif %},
    "country": {{ localization.country.iso_code | json }},
    "currency": {{ cart.currency.iso_code | json }},
    "cartTotal": {{ cart.total_price | json }},
    "cartLines": [{%- for item in cart.items -%}{"key": {{ item.key | json }}, "variant": {{ item.variant_id | json }}, "product": {{ item.product_id | json }}, "qty": {{ item.quantity }}, "price": {{ item.final_line_price | json }}, "offer": {{ item.properties._oo_offer | json }}, "gift": {{ item.properties._oo_gift | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    "designMode": {{ request.design_mode | json }},
    "assets": {{ 'orderorbit.js' | asset_url | json }}
  }
</script>
